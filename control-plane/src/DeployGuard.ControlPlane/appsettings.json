{
  "DataMode": "connected",
  "Upstream": {
    "BaseUrl": "",
    "ReadinessPath": "/api/v1/health/ready",
    "TimeoutSeconds": 3
  },
  "Database": {
    "ProbeEnabled": false
  },
  "ForwardedHeaders": {
    "TrustedProxyCidrs": [
      "127.0.0.1/32",
      "::1/128"
    ]
  },
  "ConnectionStrings": {
    "DeployGuard": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Warning"
    }
  },
  "AllowedHosts": "*"
}
