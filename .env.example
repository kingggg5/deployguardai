# Backend
DATABASE_URL=sqlite:///./deployguard.db
RUN_MIGRATIONS_ON_STARTUP=true
# Explicit opt-in only for reproducible evaluation data. Leave false for real
# repository/provider testing.
SEED_SYNTHETIC_DATA=false
API_HOST=127.0.0.1
API_PORT=8100
CORS_ORIGINS=http://127.0.0.1:4300,http://localhost:4300
LOG_LEVEL=INFO
GITHUB_WEBHOOK_SECRET=
# Root secret used to derive per-workspace collector credentials (32+ chars in production).
TELEMETRY_INGEST_TOKEN=
ALLOW_DATABASE_RESET=false
AUTH_PROVIDER=development
DEVELOPMENT_USER_EMAIL=owner@deployguard.local
DEVELOPMENT_USER_NAME=Local workspace owner
ACCESS_TOKEN_TTL_HOURS=12
INVITATION_TTL_HOURS=72
# Production requires AUTH_PROVIDER=oidc and all values below.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_SCOPE=openid profile email
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
OIDC_LEEWAY_SECONDS=30
FRONTEND_PUBLIC_URL=http://127.0.0.1:4300

# GitHub App: keep the PEM only in a secret manager in production.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_CHECKS_ENABLED=false
GITHUB_WEBHOOK_MAX_BODY_BYTES=1048576
MAX_REQUEST_BODY_BYTES=2097152
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# Optional OTLP/HTTP traces endpoint. For the Compose observability profile use:
# http://otel-collector:4318/v1/traces
OTEL_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=deployguard-api
OTEL_EXPORT_TIMEOUT_SECONDS=5

# Production invitation delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# PostgreSQL profile
POSTGRES_DB=deployguard
POSTGRES_USER=deployguard_owner
POSTGRES_PASSWORD=replace-owner-password-for-local-compose
POSTGRES_APP_USER=deployguard
POSTGRES_APP_PASSWORD=replace-runtime-password-for-local-compose
# Optional API/worker URL override for Compose (for example a non-owner role
# against managed PostgreSQL). Kept separate from local DATABASE_URL so copying
# this file does not accidentally put the containers on SQLite.
COMPOSE_DATABASE_URL=
# Used only by the one-shot `docker compose --profile operations run migrate`.
# Production must inject a short-lived schema-owner URL into that job only.
MIGRATION_DATABASE_URL=

# Frontend uses the same-origin /api/v1 route by default.
# Override it at runtime with window.__DEPLOYGUARD_CONFIG__.apiBaseUrl
# or the deployguard-api-base meta tag in frontend/src/index.html.
