# Template only. Inject real values from a managed secret/config provider.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://deployguard:REPLACE_FROM_SECRET_MANAGER@postgres.example:5432/deployguard?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.crt
COMPOSE_DATABASE_URL=postgresql+psycopg://deployguard:REPLACE_FROM_SECRET_MANAGER@postgres.example:5432/deployguard?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.crt
# Npgsql connection used only by the .NET control-plane readiness probe. Keep
# its host/database/runtime role aligned with COMPOSE_DATABASE_URL.
CONTROL_PLANE_DATABASE_CONNECTION_STRING=Host=postgres.example;Port=5432;Database=deployguard;Username=deployguard;Password=REPLACE_FROM_SECRET_MANAGER;SSL Mode=VerifyFull;Root Certificate=/run/secrets/postgres-ca.crt;Pooling=true;Maximum Pool Size=64;Timeout=5;Command Timeout=5
# Trust only the private proxy/service-network CIDR; never use `*` in production.
CONTROL_PLANE_TRUSTED_PROXY_CIDR=172.16.0.0/12
PYTHON_API_FORWARDED_ALLOW_IPS=172.16.0.0/12
RUN_MIGRATIONS_ON_STARTUP=false
# Inject only into `python -m app.migrate`, never into API/worker containers.
MIGRATION_DATABASE_URL=postgresql+psycopg://deployguard_owner:REPLACE_FROM_SECRET_MANAGER@postgres.example:5432/deployguard?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.crt
# Inject only into short-lived backup/retention jobs. These roles need audited
# cross-tenant access and must never be used by API/worker processes.
BACKUP_DATABASE_URL=postgresql://deployguard_backup:REPLACE_FROM_SECRET_MANAGER@postgres.example:5432/deployguard?sslmode=verify-full
RETENTION_DATABASE_URL=postgresql+psycopg://deployguard_retention:REPLACE_FROM_SECRET_MANAGER@postgres.example:5432/deployguard?sslmode=verify-full
RESTORE_ADMIN_DATABASE_URL=postgresql+psycopg://deployguard_restore_admin:REPLACE_FROM_SECRET_MANAGER@postgres.example:5432/postgres?sslmode=verify-full
RESTORE_APPLICATION_DATABASE_URL=postgresql+psycopg://deployguard:REPLACE_FROM_SECRET_MANAGER@postgres.example:5432/deployguard?sslmode=verify-full
SEED_SYNTHETIC_DATA=false
ALLOW_DATABASE_RESET=false

AUTH_PROVIDER=oidc
OIDC_ISSUER=https://identity.example
OIDC_AUDIENCE=deployguard-api
OIDC_CLIENT_ID=deployguard-web
OIDC_SCOPE=openid profile email
OIDC_JWKS_URL=https://identity.example/.well-known/jwks.json
OIDC_ALGORITHMS=RS256

FRONTEND_PUBLIC_URL=https://deployguard.example
CORS_ORIGINS=https://deployguard.example

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CHECKS_ENABLED=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
# Required for SMTP. Inject from the managed secret provider; never put it in
# a background-job payload or application log.
INVITATION_TOKEN_SECRET=

TELEMETRY_INGEST_TOKEN=
OTEL_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_SERVICE_NAME=deployguard-api
# Optional .NET OTLP/gRPC export. Leave empty when the observability profile is off.
CONTROL_PLANE_OTLP_ENDPOINT=http://otel-collector:4317

# Production Collector exporter (deploy/otel/collector.production.yaml).
OBSERVABILITY_OTLP_ENDPOINT=https://telemetry.example
OBSERVABILITY_OTLP_TOKEN=
DEPLOYGUARD_API_METRICS_TARGET=python-api:8100

# Explicit operator attestations consumed by scripts/production_readiness.py.
DEPLOYGUARD_TLS_TERMINATED=false
DEPLOYGUARD_MANAGED_SECRETS=false
DEPLOYGUARD_DISTRIBUTED_RATE_LIMIT=false
DEPLOYGUARD_BACKUP_CONFIGURED=false
DEPLOYGUARD_RESTORE_REHEARSED=false
DEPLOYGUARD_RETENTION_SCHEDULED=false
DEPLOYGUARD_IMMUTABLE_AUDIT_CONFIGURED=false
DEPLOYGUARD_WORKER_SUPERVISED=false
DEPLOYGUARD_TELEMETRY_BACKEND_CONFIGURED=false
DEPLOYGUARD_ALERTING_CONFIGURED=false
DEPLOYGUARD_ON_CALL_CONFIGURED=false
