<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>DeployGuard.ReadOnlySpike</RootNamespace>
    <AssemblyName>deployguard-readonly-spike</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../scripts/evaluation/golden-corpus-v1.json"
          Link="corpus/golden-corpus-v1.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../scripts/contracts/v1/openapi.json"
          Link="contracts/openapi.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../scripts/contracts/v1/representative-responses.json"
          Link="contracts/representative-responses.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
